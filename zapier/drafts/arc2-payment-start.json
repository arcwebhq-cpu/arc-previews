  },
  "trigger": {
    "kind": "scheduled-private-action",
    "provider": "ARC private Zapier integration",
    "poll_concurrency": 1,
    "catch_hook_allowed": false
  },
  "controls": {
    "draft_gate": "ARC_ZAPIER_PAYMENT_ARC2_RUN_ONE_ENABLED",
    "draft_gate_default": false,
    "secret_presence_enables_action": false,
    "site_gate": "ARC_PAYMENT_ARC2_RUN_ONE_ENABLED",
    "site_gate_default": false,
    "stripe_live_mode_enabled": false,
    "provider_actions_default": false
  },
  "secret_environment_names": ["ARC_ZAPIER_PAYMENT_ARC2_RUN_ONE_SECRET"],
  "secret_custody": "Zapier private-version environment only",
  "steps": [
    {
      "order": 1,
      "id": "off_guard",
      "component": "private_version_secret_guard",
      "action": "continue_only_when_gate_is_exact_true_then_require_secret",
      "activation_environment_name": "ARC_ZAPIER_PAYMENT_ARC2_RUN_ONE_ENABLED",
      "secret_environment_name": "ARC_ZAPIER_PAYMENT_ARC2_RUN_ONE_SECRET",
      "configured_value": false,
      "provider_action": false
    },
    {
      "order": 2,
      "id": "run_one_dispatch",
      "component": "arc_private.payment_arc2_run_one_v1",
      "action": "bounded_bearer_post_empty_json",
      "request": {
        "method": "POST",
        "target_environment": "sandbox",
        "origin": "https://arc2-sandbox.netlify.app",
        "production_origin_requires_new_reviewed_version": "https://arcweb.onl",
        "path": "/internal/payment-arc2/run-one",
        "body": {},
        "authentication": "Bearer ARC_ZAPIER_PAYMENT_ARC2_RUN_ONE_SECRET",
        "origin_header_allowed": false,
        "timeout_ms": 10000,
        "maximum_response_bytes": 4096,
        "redirects_allowed": false
      },
      "provider_action": false
    },
    {
      "order": 3,
      "id": "redacted_result",
      "component": "arc_private.fixed_redacted_result_v1",
      "action": "validate_exact_response_and_emit_allowlisted_fields",
      "accepted_http_statuses": [200, 202, 409],
      "accepted_states": ["IDLE", "COMPLETED", "RETRY_REQUIRED", "REVIEW_REQUIRED"],
      "raw_response_output_allowed": false,
      "provider_action": false
    }
  ],
  "retry_contract": {
    "http_202_means_complete": false,
    "timeout_marks_complete": false,
    "automatic_provider_replay_allowed": false,
    "retry_required_is_log_safe_output_only": true,
    "first_party_worker_owns_claim_binding_recheck_replay_and_completion": true,
    "authoritative_stripe_session_to_payment_intent_validation_required_before_signing": true,
    "binding_evidence_exact_canonical_bytes_replay_required": true,
    "binding_signature_exact_replay_required": true,
    "binding_retry_may_regenerate_issued_at": false,
    "binding_retry_may_resign": false
  },
  "forbidden_components": [
    "bundle.inputData",
    "Zapier-side claim tokens or artifact construction",
    "raw Checkout Session ID or recipient in task history",
    "HTTP 202 treated as fulfillment",
    "Stripe Payment Link"
  ],
  "source_contracts": [
    "zapier/private-integration/cli-app/src/provider-adapters.js",
    "zapier/private-integration/cli-app/src/network-barrier.js",
    "zapier/wiring-contract.json"
  ],
  "activation_evidence_required": [
    "payment_arc2_workflow_id_sha256",
    "payment_arc2_workflow_version_readback_sha256",
    "exact origin and path readback",
    "history-redaction readback",
    "sandbox IDLE, COMPLETED, RETRY_REQUIRED, REVIEW_REQUIRED, and fixed-error receipts"
  ],
  "blocking_reasons": [
    "private app version 0.0.2 is not installed or published",
    "per-version bearer is absent and the site run-one gate remains OFF",
    "sandbox provider and history-redaction receipts are absent"
  ]
}
