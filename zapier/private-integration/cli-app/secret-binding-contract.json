{
  "schema": "arc-zapier-v11-run-one-secret-binding-v1",
  "app_version": "0.0.2",
  "target_environment": "sandbox",
  "secret_values_present": false,
  "bindings": [
    {
      "zapier_action_key": "arc1_review_revision",
      "zapier_secret_environment_name": "ARC_ZAPIER_REVIEW_REVISION_RUN_ONE_SECRET",
      "site_bearer_environment_name": "ARC_REVIEW_REVISION_RUN_ONE_INTERNAL_AUTH_SECRET",
      "binding": "same-opaque-value-in-distinct-secret-stores",
      "value_recorded": false
    },
    {
      "zapier_action_key": "arc2_payment_start",
      "zapier_secret_environment_name": "ARC_ZAPIER_PAYMENT_ARC2_RUN_ONE_SECRET",
      "site_bearer_environment_name": "ARC_PAYMENT_ARC2_RUN_ONE_SECRET",
      "binding": "same-opaque-value-in-distinct-secret-stores",
      "value_recorded": false
    }
  ],
  "zapier_names_distinct_from_site_names": true,
  "site_bearer_names_distinct_per_action": true
}
